{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "completion": {
        "autoRequire": true,
        "callSnippet": false,
        "postfix": "@"
    },
    "diagnostics": {
        "globals": [],
        "disable": [
            "call-non-callable",
            "duplicate-type",
            "duplicate-doc-field",
            "duplicate-set-field",
            "need-check-nil",
            "unnecessary-assert",
            "unnecessary-if"
        ]
    },
    "workspace": {
        "library": [
            "venv/share/lua/5.1",
            "@luagir",
            "{luarocks}"
        ],
        "workspaceRoots": [
            "./astal"
        ]
    },
    "runtime": {
        "version": "LuaJIT",
        "requirePattern": [
            "astal/?.lua",
            "astal/?/init.lua",
            "venv/share/lua/5.1/?.lua",
            "venv/share/lua/5.1/?/init.lua"
        ]
    }
}
