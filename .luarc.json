{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "completion": {
        "autoRequire": true,
        "callSnippet": false,
        "postfix": "@"
    },
    "diagnostics": {
        "globals": [],
        "disable": [
            "call-non-callable"
        ]
    },
    "workspace": {
        "library": [
            "venv/share/lua/5.1",
            "@luagir",
            "{luarocks}"
        ],
        "workspaceRoots": [
            "./src"
        ]
    },
    "runtime": {
        "version": "LuaJIT",
        "requirePattern": [
            "src/?.lua",
            "src/?/init.lua",
            "venv/share/lua/5.1/?.lua",
            "venv/share/lua/5.1/?/init.lua"
        ]
    }
}
